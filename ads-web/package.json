{
  "name": "ads-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler d1 migrations apply DB --local && wrangler dev",
    "dev:web": "vite",
    "build": "vite build",
    "test": "node --test worker/*.test.ts",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p web",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run build && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "snapshot:load": "node scripts/load-snapshot.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260928.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "wrangler": "^4.142.0"
  }
}
