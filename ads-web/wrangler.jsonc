// Cloudflare Worker: API + scheduled rule runs + the React dashboard (static assets).
// Secrets (set with `npx wrangler secret put NAME`, never in this file):
//   META_ACCESS_TOKEN, META_APP_SECRET + META_WEBHOOK_VERIFY_TOKEN (Messenger webhook), LINE_CHANNEL_ACCESS_TOKEN (optional), LINE_TO (optional)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pkjeans-ads",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/webhook/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pkjeans-ads",
      "database_id": "a1064631-6b86-4df4-b121-afcf994be552",
      "migrations_dir": "migrations"
    }
  ],
  // Rules at 08:00 and 20:00 Bangkok (UTC+7); costs re-sync from the Google Sheet at 07:30. Keep in sync with worker/index.ts.
  "triggers": { "crons": ["0 1,13 * * *", "30 0 * * *", "0 3 * * *", "15 */3 * * *"] },
  "vars": {
    "META_AD_ACCOUNT_ID": "act_2149666808519411",
    "META_API_VERSION": "v21.0",
    "META_APP_ID": "1410718820800711",
    // Discord bot (buttons for approvals): fill both after creating the app; DISCORD_BOT_TOKEN is a secret.
    "DISCORD_APP_PUBLIC_KEY": "f71bc17992190e854afb9b526de0bd66b2b7137fb5bb6259593896417d5bcb28",
    "DISCORD_APP_ID": "1559484006742102026",
    "DISCORD_CHANNEL_ID": "1179322183663759390",
    // Discord user IDs pinged on every question (Max). Right-click the person → Copy User ID.
    "DISCORD_DECIDER_IDS": "698435075422945301",
    // Discord user IDs allowed to press the buttons (Benz, Max). Empty = anyone in the channel.
    "DISCORD_APPROVER_IDS": "869116667945439323,698435075422945301",
    // Discord user IDs who upload Page365 (มอส): tagged at 10:00 when yesterday's file is missing.
    "DISCORD_UPLOADER_IDS": "1460928261017309299",
    // Discord user IDs tagged on bills the auto-fill leaves for a person (เนย, Benz 15 Oct); empty = the deciders.
    "DISCORD_ORDER_OWNER_IDS": "1044965812810809405",
    // Anthropic workspace that pays for (and caps, $20/month) the nightly chat read; the key is a secret.
    "ANTHROPIC_WORKSPACE_ID": "wrkspc_015DExBRoBN7XAb6TgX2Cudh",
    // Messenger echo app ids. 237031236431724 = Page365 (admins). 263902037430900 = Meta's own app, used by BOTH the
    // Business Suite inbox and Business AI, so its lines stay "เพจ" and the AI tells them apart by wording.
    "CHAT_HUMAN_APP_IDS": "237031236431724",
    "CHAT_BOT_APP_IDS": "",
    // Who pastes approved answers into Business AI each Monday (Fear); empty = tag the deciders.
    "DISCORD_KB_UPDATER_IDS": "1179672160122458124",
    // Discord "service ลูกค้า": complaints / refunds / wrong items tag these people (Fear); the webhook URL is the secret DISCORD_SERVICE_WEBHOOK_URL.
    "DISCORD_SERVICE_IDS": "1179672160122458124",
    // #meta-chat: bot posts about chats and the answer bank (fixes with buttons, Fear's Monday reminder).
    "DISCORD_CHAT_CHANNEL_ID": "1560180109045014528",
    // /ไอเดีย feature requests (worker/featureRequests.ts): the forum channel id; empty = off. Deciders (ให้ทำ/ผ่าน) = Benz.
    "DISCORD_REQUEST_CHANNEL_ID": "",
    "DISCORD_REQUEST_DECIDER_IDS": "869116667945439323",
    // Owners: always allowed to manage users on the ผู้ใช้ page (comma separated).
    "OWNER_EMAILS": "arnun.tre@benzarnun.com,ps.maxpollawat@gmail.com",
    // Cloudflare Access sync: account + the reusable policy "PkJeans team" (token is the secret CF_API_TOKEN).
    "CF_ACCOUNT_ID": "bbad0b69f4554a5d9e58085286f3eb9b",
    "CF_ACCESS_POLICY_ID": "c21b794b-dd95-4d8f-86df-ad7347a24fe5",
    // Cloudflare Access (Worker → Access tab → Application values). Empty = every /api call is refused.
    "ACCESS_TEAM_DOMAIN": "https://broad-cell-d05a.cloudflareaccess.com",
    "ACCESS_AUD": "468421c1e47c4a4bde081a9e8b6dfe02f22dfa4305edd0faf64a16f08cc48a0a"
  },
  "observability": { "enabled": true }
}
