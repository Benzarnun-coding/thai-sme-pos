# --- Meta (required) ---
# System User token from Meta Business Suite with ads_read + ads_management
META_ACCESS_TOKEN=
# e.g. act_2149666808519411 (PkJeans) — one account per .env
META_AD_ACCOUNT_ID=

# --- Safety ---
# true = report only, never touch Meta (default). Set false to apply changes.
DRY_RUN=true
# true = exit immediately without doing anything
KILL_SWITCH=false

# --- LINE report (optional; leave blank to skip) ---
# Messaging API channel access token + your user ID or group ID
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TO=

# --- Optional: use a different rules file ---
# RULES_FILE=./rules.pkjeans.json
