# --- database ---
# leave empty to use embedded PGlite under server/data/pglite (dev)
DATABASE_URL=
# DATABASE_URL=postgres://loopdesk:secret@localhost:5432/loopdesk

# --- server ---
PORT=3001
STORE_ID=climax

# --- facebook (READ ONLY in project 1) ---
# Page token with: pages_read_engagement, read_insights (and ads_read for the ad account)
FB_PAGE_ID=
FB_PAGE_TOKEN=
FB_AD_ACCOUNT_ID=
FB_ADS_TOKEN=
FB_DATE_PRESET=last_7d
FB_SYNC_CRON=5 */6 * * *

# --- connect-account flow (OAuth) ---
# 32 random bytes, base64: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# where the browser comes back to, and where this API is reachable from it
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:3001
# Meta App — without these the Connect button runs a labelled demo instead
FB_APP_ID=
FB_APP_SECRET=
# optional: Facebook Login for Business configuration id (replaces the raw scope list)
FB_LOGIN_CONFIG_ID=
# how far the build has got — controls which scopes the Connect button asks for
LOOPDESK_PHASE=1

# --- AI (LoopDesk boxes) ---
# no key = demo brain (grounded in shop data, labelled). Key = claude-opus-5 per box with per-box effort.
ANTHROPIC_API_KEY=
# force demo even with a key: LOOPDESK_AI=demo
LOOPDESK_AI=
# baht per USD for the token meter (default 35). The monthly AI cap itself is set in the Studio.
LOOPDESK_THB_PER_USD=35
# every box runs on its cron (Asia/Bangkok) when the server is up; set to off for one-off scripts
LOOPDESK_SCHEDULER=

# --- LINE (approvals + daily report to the owner's phone) ---
# Messaging API channel access token, and the user / group id to push to
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TO=

# --- public pages for Meta (privacy / data deletion) ---
PUBLIC_URL=http://localhost:3001
LOOPDESK_APP_NAME=LoopDesk
LOOPDESK_CONTACT_EMAIL=
