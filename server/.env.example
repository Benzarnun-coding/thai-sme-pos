# --- database ---
# leave empty to use embedded PGlite under server/data/pglite (dev)
DATABASE_URL=
# DATABASE_URL=postgres://loopdesk:secret@localhost:5432/loopdesk

# --- server ---
PORT=3001
STORE_ID=climax

# --- facebook (READ ONLY in project 1) ---
# Page token with: pages_read_engagement, read_insights (and ads_read for the ad account)
FB_PAGE_ID=
FB_PAGE_TOKEN=
FB_AD_ACCOUNT_ID=
FB_ADS_TOKEN=
FB_DATE_PRESET=last_7d
FB_SYNC_CRON=5 */6 * * *

# --- connect-account flow (OAuth) ---
# 32 random bytes, base64: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# where the browser comes back to, and where this API is reachable from it
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:3001
# Meta App — without these the Connect button runs a labelled demo instead
FB_APP_ID=
FB_APP_SECRET=
# optional: Facebook Login for Business configuration id (replaces the raw scope list)
FB_LOGIN_CONFIG_ID=
# how far the build has got — controls which scopes the Connect button asks for
LOOPDESK_PHASE=1
